<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextColor="@color/white" />

    <!-- 补全列表（浮动在编辑器上方） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/completion_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:background="@color/editor_bg"
        android:elevation="8dp"
        android:visibility="gone" />

    <!-- 代码编辑器（EditText 自带滚动） -->
    <com.godot.devassistant.editor.GDScriptEditorView
        android:id="@+id/editor_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:scrollbars="vertical|horizontal"
        android:inputType="textMultiLine|textNoSuggestions"
        android:imeOptions="flagNoExtractUi"
        android:typeface="monospace"
        android:textSize="14sp"
        android:padding="8dp" />

    <!-- 键盘工具栏 -->
    <com.godot.devassistant.editor.EditorKeyboardBar
        android:id="@+id/keyboard_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/keyboard_bar_bg" />

</LinearLayout>
